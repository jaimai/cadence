# Postgres alwaysdata : hôte du type postgresql-<compte>.alwaysdata.net
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Chiffre les jetons OAuth en base. La changer rend les comptes connectés inutilisables.
ENCRYPTION_KEY=

API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
# lax par défaut. none (avec COOKIE_SECURE=true) si l'app est affichée dans une iframe.
COOKIE_SAMESITE=lax
# Passer à false une fois ton compte créé, tant que le produit n'est pas ouvert.
ALLOW_SIGNUP=true

# "local" en développement, "r2" en production.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domaine public du bucket, sans slash final (ex. https://media.mondomaine.com)
R2_PUBLIC_BASE_URL=

# App Meta (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# App Instagram (tableau de bord Meta > Instagram > "API setup with Instagram login").
# Identifiants distincts de ceux de l'app Meta ci-dessus.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# App TikTok (developers.tiktok.com), produits Login Kit et Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# SELF_ONLY tant que l'app n'est pas auditée, puis PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
