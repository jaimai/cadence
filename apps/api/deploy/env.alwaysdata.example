# Configuration de production sur alwaysdata. À copier vers apps/api/.env
# Remplace COMPTE par le nom de ton compte alwaysdata.

# Base créée dans Bases de données > PostgreSQL.
DATABASE_URL=postgresql+asyncpg://UTILISATEUR:MOT_DE_PASSE@postgresql-COMPTE.alwaysdata.net:5432/NOM_DE_LA_BASE

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Chiffre les jetons des comptes connectés : ne plus la changer ensuite.
ENCRYPTION_KEY=

# Adresse publique de l'API (celle du site alwaysdata) et du front (Vercel).
API_BASE_URL=https://COMPTE.alwaysdata.net
WEB_BASE_URL=https://TON-PROJET.vercel.app

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Laisse true le temps de créer ton compte, puis passe à false et redémarre.
ALLOW_SIGNUP=true

# Médias. "local" les garde sur le disque alwaysdata : suffisant pour LinkedIn et X,
# mais Instagram, TikTok et Facebook exigent "r2".
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=/home/COMPTE/cadence-media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Identifiants des apps de chaque réseau (voir le README). Vide = réseau désactivé.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
